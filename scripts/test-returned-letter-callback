#!/usr/bin/env node
/**
 * Verifies the returned-letters callback route end-to-end against a running local instance.
 * Usage: NOTIFY_CALLBACK_BEARER_TOKEN=<token> which can be input inline or stored in env - followed by : node scripts/test-returned-letter-callback
 */

const { Sequelize, DataTypes } = require('sequelize')
const { randomUUID: crypto } = require('node:crypto')
const http = require('node:http')

// bypass HTTP_PROXY - Node fetch does not honour NO_PROXY
const postJson = (url, headers, body) => new Promise((resolve, reject) => {
  const { hostname, port, pathname } = new URL(url)
  const data = JSON.stringify(body)
  const req = http.request({ hostname, port, path: pathname, method: 'POST', headers: { ...headers, 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } }, (res) => {
    res.resume()
    resolve({ status: res.statusCode })
  })
  req.on('error', reject)
  req.write(data)
  req.end()
})

const BASE_URL = process.env.SERVICE_URL ?? 'http://127.0.0.1:3010'
const BEARER_TOKEN = process.env.NOTIFY_CALLBACK_BEARER_TOKEN

if (!BEARER_TOKEN) {
  console.error('NOTIFY_CALLBACK_BEARER_TOKEN env var is required')
  process.exit(1)
}

const sequelize = new Sequelize(
  process.env.POSTGRES_DB ?? 'ffc_doc_statement_publisher',
  process.env.POSTGRES_USERNAME ?? 'postgres',
  process.env.POSTGRES_PASSWORD ?? 'ppp',
  {
    host: process.env.POSTGRES_HOST ?? 'localhost',
    port: Number(process.env.POSTGRES_PORT ?? 5487),
    dialect: 'postgres',
    logging: false,
    schema: process.env.POSTGRES_SCHEMA_NAME ?? 'public'
  }
)

const ReturnedLetter = sequelize.define('returnedLetter', {
  notificationId: DataTypes.STRING,
  reference: DataTypes.STRING,
  dateSent: DataTypes.DATE,
  receivedAt: DataTypes.DATE
}, { tableName: 'returned_letters', timestamps: false })

const NOTIFICATION_ID = crypto()

const TEST_PAYLOAD = {
  notification_id: NOTIFICATION_ID,
  reference: 'DELINKED_TEST_00000001_2026_statement.pdf',
  date_sent: new Date().toISOString()
}

const run = async () => {
  console.log(`\nPosting to ${BASE_URL}/notify/callback/returned-letters`)
  console.log('Payload:', JSON.stringify(TEST_PAYLOAD, null, 2))

  // 1. Valid request should save and return 200
  const validResponse = await postJson(`${BASE_URL}/notify/callback/returned-letters`, { Authorization: `Bearer ${BEARER_TOKEN}` }, TEST_PAYLOAD)

  console.log(`\n[1] Valid request → HTTP ${validResponse.status}`)
  if (validResponse.status !== 200) {
    console.error('    FAIL: expected 200')
    process.exit(1)
  }
  console.log('    PASS')

  // 2. Verify the record was persisted in the DB
  const saved = await ReturnedLetter.findOne({ where: { notificationId: NOTIFICATION_ID } })
  console.log('\n[2] DB record persisted')
  if (!saved) {
    console.error('    FAIL: no record found in returned_letters table')
    process.exit(1)
  }
  console.log(`    notificationId : ${saved.notificationId}`)
  console.log(`    reference      : ${saved.reference}`)
  console.log(`    dateSent       : ${saved.dateSent}`)
  console.log(`    receivedAt     : ${saved.receivedAt}`)
  if (!saved.receivedAt) {
    console.error('    FAIL: receivedAt is not set')
    process.exit(1)
  }
  console.log('    PASS')

  // 3. Wrong token should be rejected
  const badTokenResponse = await postJson(`${BASE_URL}/notify/callback/returned-letters`, { Authorization: 'Bearer wrong-token' }, { ...TEST_PAYLOAD, notification_id: crypto() })

  console.log(`\n[3] Wrong bearer token → HTTP ${badTokenResponse.status}`)
  if (badTokenResponse.status !== 401) {
    console.error('    FAIL: expected 401')
    process.exit(1)
  }
  console.log('    PASS')

  // 4. Duplicate notificationId should fail gracefully (unique constraint)
  const dupeResponse = await postJson(`${BASE_URL}/notify/callback/returned-letters`, { Authorization: `Bearer ${BEARER_TOKEN}` }, TEST_PAYLOAD)

  console.log(`\n[4] Duplicate notificationId → HTTP ${dupeResponse.status}`)
  if (dupeResponse.status !== 500) {
    console.error('    FAIL: expected 500 from unique constraint violation')
    process.exit(1)
  }
  console.log('    PASS')

  // Clean up test record
  await ReturnedLetter.destroy({ where: { notificationId: NOTIFICATION_ID } })
  console.log('\nTest record cleaned up.')
  console.log('\nAll checks passed.\n')

  await sequelize.close()
}

run().catch(async (err) => {
  console.error('\nUnexpected error:', err.message)
  await sequelize.close()
  process.exit(1)
})
